# Banking Web frontend environment variables
# Copy this file to .env.local for local development.

# Optional local fallback for REST calls in src/api/bffClient.ts.
# Leave empty to use relative /api paths and Vite proxy.
VITE_BACKEND_URI=

# Production API bases (including /api) for the separate App Services.
# The root Terraform stack supplies these during the deployed frontend build.
VITE_ACCOUNT_API_URL=
VITE_TRANSACTION_API_URL=

# Responses BFF endpoint used by chat UI components.
# Leave empty to use relative /responses and the Vite proxy locally.
VITE_RESPONSES_API_URL=
