# Banking Web frontend environment variables
# Copy this file to .env.local for local development.

# Absolute base URLs (including /api) for the separate Account/Transaction App
# Services. Every environment, local and deployed, sets these explicitly; there
# is no dev-server proxy for them.
VITE_ACCOUNT_API_URL=
VITE_TRANSACTION_API_URL=

# Responses BFF endpoints used by chat UI components and authentication.
# Every environment sets these explicitly; there is no dev-server proxy.
VITE_RESPONSES_API_URL=
VITE_RESPONSES_BFF_URL=
