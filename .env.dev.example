# Shared BFF-to-agent-to-MCP signing secret
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-random-characters

# Shared PostgreSQL connection used by the Account and Transaction MCP services
DATABASE_URL=

# Shared application JWT signing secret; must match the BFF's JWT_SECRET_KEY so
# Account/Transaction can verify the browser's bearer token directly
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Allowed browser origin for Account/Transaction CORS (comma-separated if more than one)
CORS_ALLOWED_ORIGINS=http://localhost:5170
